# ---------------------------------------------------------------------------
# 复制为 .env 后填写。demo 代码通过 shared.config 读取，从不硬编码 key。
# ---------------------------------------------------------------------------

# Principle: Model-agnostic —— 换模型 = 改这一个字符串。
# 只要模型支持 tool calling 就能用：frontier API / open-weight / 本地。
DEEPAGENTS_MODEL=anthropic:claude-sonnet-4-6
# 其他可选值（装好对应 provider 包即可）：
#   openai:gpt-5.5
#   google_genai:gemini-3.6-flash
#   ollama:qwen3           （本地，需要 langchain-ollama）

# --- 各 provider 的 key（只填你在用的那个）---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Principle: Production-ready —— first-class tracing / evaluation ---
# 设置后所有 demo 的 LangGraph 节点都会自动上报到 LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepagents-features-demo

# --- Principle: Persistent memory —— StoreBackend 需要一个可持久化的 store ---
# 生产环境换成 Postgres-backed store（langgraph-store-postgres）即可
# LANGGRAPH_STORE_URL=postgresql://user:pass@localhost:5432/deepagents

# --- 可选：远端沙箱（Shell access）---
DAYTONA_API_KEY=
# MODAL_TOKEN_ID=
# RUNLOOP_API_KEY=
